{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2020"],
    "typeRoots": ["../player-probe/node_modules/@types"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": "../../.local/native-deployment/compiled"
  },
  "include": ["*.ts", "tests/**/*.ts"]
}
