{
  "compilerOptions": {
    "target": "ES2018",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2018"],
    "typeRoots": ["../player-probe/node_modules/@types"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmitOnError": true,
    "rootDir": "../..",
    "outDir": "../../.local/native-package/compiled"
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "build.ts", "index.ts", "producer.ts", "package-phase.ts"]
}
